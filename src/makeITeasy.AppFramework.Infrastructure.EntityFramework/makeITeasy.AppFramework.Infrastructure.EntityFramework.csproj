<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Emmanuel D.</Authors>
		<Company>Make IT Easy</Company>
		<Description>Infrastructure module for makeITeasy.Appframework for Entity Framework 8</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Manu06D/makeITeasy.AppFramework</RepositoryUrl>
		<PackageTags>framework ef</PackageTags>
		<Version>10.2.0-beta01</Version>
		<PackageReleaseNotes>
			10.2.0  : Rework dotnet dependencies
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Update="Microsoft.SourceLink.GitHub" />
		<PackageReference Include="DelegateDecompiler.EntityFrameworkCore5" />
		<PackageReference Include="Facet.Extensions.EFCore" />
		<PackageReference Include="Facet.Extensions.EFCore.Mapping" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="EFCore.BulkExtensions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\makeITeasy.AppFramework.Core\makeITeasy.AppFramework.Core.csproj" />
		<ProjectReference Include="..\makeITeasy.AppFramework.Models\makeITeasy.AppFramework.Models.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Persistence\BaseEfRepository.net8.cs" />
		<Compile Remove="Persistence\BaseEfRepository.net10.cs" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<DefineConstants>$(DefineConstants);NET10</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Include="Persistence\BaseEfRepository.net10.cs" />
		<None Include="Persistence\BaseEfRepository.net8.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<Compile Include="Persistence\BaseEfRepository.net8.cs" />
		<None Include="Persistence\BaseEfRepository.net10.cs" />
	</ItemGroup>
	
	<ItemGroup>
		<!-- AutoMapper removed: migrated to Facet -->
	</ItemGroup>
</Project>
