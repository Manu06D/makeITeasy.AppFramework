<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Emmanuel D.</Authors>
		<Company>Make IT Easy</Company>
		<Description>Infrastructure module for makeITeasy.Appframework for Entity Framework 9</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Manu06D/makeITeasy.AppFramework</RepositoryUrl>
		<PackageTags>framework ef</PackageTags>
		<Version>9.1.28</Version>
		<PackageReleaseNotes>
			9.1.28 : Remove ICurrentDateProvider
			9.1.27 : Dependencies update
			9.1.26 : Update expression filtering
			9.1.25 : Dependencies update.
			9.1.24 : Dependencies update.
			9.1.23 : Dependencies update.
			9.1.22 : Initial Release
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="EFCore.BulkExtensions.Core" Version="[9.0.2,10.0)" />
		<PackageReference Include="EFCore.BulkExtensions.SqlServer" Version="[9.0.2,10.0)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="[9.0.16,10.0)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\makeITeasy.AppFramework.Core\makeITeasy.AppFramework.Core.csproj" />
		<ProjectReference Include="..\makeITeasy.AppFramework.Models\makeITeasy.AppFramework.Models.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" />
	</ItemGroup>

	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" PackageId="AutoMapper" Reason="Known advisory; internal work around applied" />
		<PackageVersion Include="AutoMapper" Version="14.0.0" />
	</ItemGroup>
</Project>
