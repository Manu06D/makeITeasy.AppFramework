<Project>
 <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
	 <ImplicitUsings>enable</ImplicitUsings>
	 <Nullable>enable</Nullable>
	 <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" Condition="'$(ManagePackageVersionsCentrally)' != 'true'"/>
	<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" Condition="'$(ManagePackageVersionsCentrally)' == 'true'"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
	<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>