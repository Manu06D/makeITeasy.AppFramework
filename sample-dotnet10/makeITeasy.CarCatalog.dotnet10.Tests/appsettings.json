{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Debug"
      }
    },
    "Using": [ "Serilog.Sinks.Debug" ],
    "WriteTo": [
      { "Name": "Debug" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SampleApp"
    },
    "Destructure": [
      {
        "Name": "With",
        "Args": { "policy": "makeITeasy.CarCatalog.dotnet10.Tests.DestructuringPolicy, makeITeasy.CarCatalog.dotnet10.Tests" }
      }
    ]
  },
  "AllowedHosts": "*"
}